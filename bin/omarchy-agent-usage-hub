#!/usr/bin/python3
# omarchy:summary=Print the Unified Agent Hub usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Unified Agent Hub usage into one display-ready JSON record for Omarchy."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

# Add scripts directory to path
current_dir = Path(__file__).resolve().parent
scripts_dir = current_dir.parent / "scripts"
if str(scripts_dir) not in sys.path:
    sys.path.insert(0, str(scripts_dir))

from hub_scanner import scan_hub


def main() -> None:
    parser = argparse.ArgumentParser(description="Unified Agent Hub Collector for Omarchy")
    parser.add_argument("--force", action="store_true", help="Bypass cache and force refresh")
    parser.add_argument("--limits-only", action="store_true", help="Emit limits array only")
    args = parser.parse_args()

    record = scan_hub(force=args.force)
    if args.limits_only:
        print(json.dumps(record.get("quotaGroups", []), indent=2, ensure_ascii=False))
    else:
        print(json.dumps(record, indent=2, ensure_ascii=False))


if __name__ == "__main__":
    main()
