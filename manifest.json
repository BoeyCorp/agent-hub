{
  "schemaVersion": 1,
  "id": "boeycorp.agent-hub",
  "name": "Agent Hub",
  "version": "1.0.0",
  "author": "BoeyCorp & contributors",
  "license": "MIT",
  "description": "Unified AI Agent Hub for Omarchy — multi-agent session monitor, token telemetry, quota burn forecasting, and interactive launcher for Claude Code, Antigravity, and autonomous pair programmers.",
  "kinds": ["bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Agent Hub",
    "description": "Unified AI agent cockpit monitoring active sessions, tokens, quota burn rates, and prompt metrics across Claude Code and Google Antigravity.",
    "category": "AI",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "badgeMode": "active",
      "showBadge": true,
      "enableQuotaAlerts": true,
      "quotaAlertThreshold": 15,
      "notifyOnReplenish": true,
      "terminalCommand": "",
      "recentSessionsLimit": 6,
      "defaultTab": "overview",
      "enableClaude": true,
      "enableAntigravity": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 1800,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "badgeMode",
        "type": "enum",
        "label": "Bar badge mode",
        "options": ["active", "prompts", "tokens", "quota", "off"],
        "defaultValue": "active"
      },
      {
        "key": "showBadge",
        "type": "boolean",
        "label": "Show count badge in bar",
        "defaultValue": true
      },
      {
        "key": "enableQuotaAlerts",
        "type": "boolean",
        "label": "Low quota desktop alerts",
        "defaultValue": true
      },
      {
        "key": "quotaAlertThreshold",
        "type": "integer",
        "label": "Low quota alert threshold (%)",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 15
      },
      {
        "key": "notifyOnReplenish",
        "type": "boolean",
        "label": "Alert when quota replenished / reset",
        "defaultValue": true
      },
      {
        "key": "terminalCommand",
        "type": "string",
        "label": "Terminal emulator override",
        "defaultValue": ""
      },
      {
        "key": "recentSessionsLimit",
        "type": "integer",
        "label": "Default recent sessions count",
        "min": 3,
        "max": 15,
        "step": 1,
        "defaultValue": 6
      },
      {
        "key": "defaultTab",
        "type": "enum",
        "label": "Default popup tab",
        "options": ["overview", "claude", "antigravity"],
        "defaultValue": "overview"
      },
      {
        "key": "enableClaude",
        "type": "boolean",
        "label": "Enable Claude Code integration",
        "defaultValue": true
      },
      {
        "key": "enableAntigravity",
        "type": "boolean",
        "label": "Enable Google Antigravity integration",
        "defaultValue": true
      }
    ]
  }
}
