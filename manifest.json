{
  "schemaVersion": 1,
  "id": "boeycorp.agent-hub",
  "name": "Agent Hub",
  "version": "1.0.0",
  "author": "BoeyCorp & contributors",
  "license": "MIT",
  "description": "Unified AI Agent Hub for Omarchy — multi-agent session monitor, token telemetry, quota burn forecasting, and interactive launcher for Claude Code, Antigravity, and autonomous pair programmers.",
  "kinds": [
    "bar-widget"
  ],
  "activation": "on-demand",
  "entryPoints": {
    "barWidget": "Widget.qml"
  },
  "barWidget": {
    "displayName": "Agent Hub",
    "description": "Unified AI agent cockpit monitoring active sessions, tokens, quota burn rates, and prompt metrics across Claude Code, Google Antigravity, and OpenAI Codex.",
    "category": "AI",
    "allowMultiple": false,
    "defaults": {
      "refreshIntervalSec": 60,
      "badgeMode": "active",
      "showBadge": true,
      "enableMultiDot": true,
      "multiDotMode": "active",
      "enableQuotaAlerts": true,
      "notifyOnReplenish": true,
      "terminalCommand": "",
      "recentSessionsLimit": 6,
      "defaultTab": "overview",
      "enableClaude": true,
      "enableAntigravity": true,
      "enableCodex": true,
      "quotaWarnThreshold": 25,
      "quotaCritThreshold": 10,
      "limitDisplay": "left",
      "enableQuotaChips": false,
      "chipWindow": "tightest",
      "chipSecondLimit": false,
      "chipShowReset": false,
      "chipHideUsedUp": false,
      "chipMax": 3,
      "chipProviderColors": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 10,
        "max": 1800,
        "step": 10,
        "defaultValue": 60
      },
      {
        "key": "badgeMode",
        "type": "enum",
        "label": "Bar badge mode",
        "options": [
          "active",
          "prompts",
          "tokens",
          "quota",
          "cost",
          "off"
        ],
        "defaultValue": "active"
      },
      {
        "key": "limitDisplay",
        "type": "enum",
        "label": "Show limits as",
        "options": [
          "left",
          "used"
        ],
        "defaultValue": "left"
      },
      {
        "key": "showBadge",
        "type": "boolean",
        "label": "Show count badge in bar",
        "defaultValue": true
      },
      {
        "key": "enableMultiDot",
        "type": "boolean",
        "label": "Show per-agent status dots in bar",
        "defaultValue": true
      },
      {
        "key": "multiDotMode",
        "type": "enum",
        "label": "Multi-dot bar display mode",
        "options": [
          "active",
          "all"
        ],
        "defaultValue": "active"
      },
      {
        "key": "enableQuotaChips",
        "type": "boolean",
        "label": "Show quota chips in bar",
        "defaultValue": false
      },
      {
        "key": "chipWindow",
        "type": "enum",
        "label": "Limit shown on chips",
        "options": [
          "tightest",
          "5h",
          "7d",
          "monthly"
        ],
        "defaultValue": "tightest"
      },
      {
        "key": "chipSecondLimit",
        "type": "boolean",
        "label": "Second limit below the first",
        "defaultValue": false
      },
      {
        "key": "chipShowReset",
        "type": "boolean",
        "label": "Show when limits reset",
        "defaultValue": false
      },
      {
        "key": "chipHideUsedUp",
        "type": "boolean",
        "label": "Hide agents that are used up",
        "defaultValue": false
      },
      {
        "key": "chipMax",
        "type": "integer",
        "label": "Chips in the bar",
        "min": 1,
        "max": 3,
        "step": 1,
        "defaultValue": 3
      },
      {
        "key": "chipProviderColors",
        "type": "boolean",
        "label": "Provider colors on chips",
        "defaultValue": true
      },
      {
        "key": "enableQuotaAlerts",
        "type": "boolean",
        "label": "Low quota desktop alerts",
        "defaultValue": true
      },
      {
        "key": "quotaWarnThreshold",
        "type": "integer",
        "label": "Warning level (% left)",
        "min": 5,
        "max": 50,
        "step": 5,
        "defaultValue": 25
      },
      {
        "key": "quotaCritThreshold",
        "type": "integer",
        "label": "Critical level (% left)",
        "min": 1,
        "max": 25,
        "step": 1,
        "defaultValue": 10
      },
      {
        "key": "notifyOnReplenish",
        "type": "boolean",
        "label": "Alert when quota replenished / reset",
        "defaultValue": true
      },
      {
        "key": "terminalCommand",
        "type": "string",
        "label": "Terminal emulator override",
        "defaultValue": ""
      },
      {
        "key": "recentSessionsLimit",
        "type": "integer",
        "label": "Default recent sessions count",
        "min": 3,
        "max": 15,
        "step": 1,
        "defaultValue": 6
      },
      {
        "key": "defaultTab",
        "type": "enum",
        "label": "Default popup tab",
        "options": [
          "overview",
          "claude",
          "antigravity",
          "codex",
          "spend"
        ],
        "defaultValue": "overview"
      },
      {
        "key": "enableClaude",
        "type": "boolean",
        "label": "Enable Claude Code integration",
        "defaultValue": true
      },
      {
        "key": "enableAntigravity",
        "type": "boolean",
        "label": "Enable Google Antigravity integration",
        "defaultValue": true
      },
      {
        "key": "enableCodex",
        "type": "boolean",
        "label": "Enable OpenAI Codex integration",
        "defaultValue": true
      }
    ]
  }
}
